# Copy this file to ".env" and edit. docker compose reads it automatically.
# Candidate model currently being tested (must be pulled into Ollama first)
MODEL=qwen2.5:3b
# Label for the current test run, written into every log line (e.g. acc-qwen1.5b, load-qwen1.5b-r1)
RUN_ID=manual
# Ollama context window (tokens) passed to /api/generate as options.num_ctx
NUM_CTX=4096
# Pinned Ollama image version (must be a valid docker tag, e.g. docker compose exec ollama ollama --version)
OLLAMA_VERSION=0.40.0
