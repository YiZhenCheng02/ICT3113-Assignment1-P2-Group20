# Copy this file to ".env" and edit. docker compose reads it automatically.
# Candidate model currently being tested (must be pulled into Ollama first)
MODEL=qwen2.5:1.5b
# Label for the current test run, written into every log line (e.g. acc-qwen1.5b, load-qwen1.5b-r1)
RUN_ID=manual
# Pin the Ollama image once you've checked the version (docker compose exec ollama ollama --version)
OLLAMA_VERSION=latest
