# ==========================================
# FIXED FROM ASSIGNMENT 1 (record once, never change between configurations)
# ==========================================

# Pinned Ollama image version used in A1 (see models_pinned.json). docker-compose.yml has no fallback.
OLLAMA_VERSION=0.40.0

# Ollama context window, sent as options.num_ctx on every call (A1: 4096).
NUM_CTX=4096

# Model used when CLASSIFICATION_MODE=single (e.g. llama3.1:8b for the top-model-alone runs).
MODEL=llama3.1:8b

# Label for the current run, written into every log line (e.g. acc-cascade-s1, load-cascade-s1-r1).
RUN_ID=manual


# ==========================================
# CLASSIFICATION MODE
# ==========================================

# Choose how tickets are classified:
# single  = Use only one model (Assignment 1 method).
# cascade = Use a small model first. If its prediction is not accepted,
#           send the ticket to the large model (Assignment 2 method).
CLASSIFICATION_MODE=cascade


# ==========================================
# MODELS USED FOR CASCADE
# ==========================================

# The first model that receives every incoming ticket.
# This should be your smaller and faster model.
SMALL_MODEL=qwen2.5:3b

# The second model that receives tickets rejected by the small model.
# This should be your larger and more powerful model.
LARGE_MODEL=qwen2.5:7b

# ==========================================
# CASCADE SETTINGS
# ==========================================

# Choose which escalation rule to use:
# 1 = Use the category acceptance list in CASCADE_ACCEPT_SETTING_1.
# 2 = Use the category acceptance list in CASCADE_ACCEPT_SETTING_2.
CASCADE_SETTING=1

# List the categories that the small model is allowed to handle when using Setting 1.
# If the small model predicts one of these categories, accept its answer.
# Otherwise, send the ticket to the large model.
# Separate multiple category names with commas.
# Setting 1 = STRICT (k=2): accepts the two highest-precision categories.
# Tuning set: 90.32% escalated, 81/93 correct (87.10% accuracy).
CASCADE_ACCEPT_SETTING_1=Money transfer or service,Consumer loan

# List the categories that the small model is allowed to handle when using Setting 2.
# The same rule applies: accepted categories stay with the small model;
# all other predictions are sent to the large model.
# Setting 2 = LOOSE (k=4): also accepts Credit reporting and Credit card.
# Tuning set: 49.46% escalated, 79/93 correct (84.95% accuracy).
CASCADE_ACCEPT_SETTING_2=Money transfer or service,Consumer loan,Credit reporting,Credit card

# ==========================================
# OLLAMA MEMORY SETTINGS
# ==========================================

# OLLAMA_MAX_LOADED_MODELS is fixed at 2 inside docker-compose.yml (not set here), so both cascade
# models can stay loaded and the value cannot change between configurations (brief, Scope).
